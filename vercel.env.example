# Frontend (Vercel > Environment Variables)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_NEW_SUPABASE_SECRET
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash

META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
APP_URL=https://YOUR_PROJECT.vercel.app
OAUTH_STATE_SECRET=LONG_RANDOM_SECRET
META_API_VERSION=v24.0
META_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
META_FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish
META_INSTAGRAM_REDIRECT_URI=https://YOUR_PROJECT.vercel.app/api/auth/instagram/callback
META_FACEBOOK_REDIRECT_URI=https://YOUR_PROJECT.vercel.app/api/auth/facebook/callback
